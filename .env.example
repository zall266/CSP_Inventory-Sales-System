# Vite does not load this file.
# Local development reads .env.development, which points Module 1 at the DEV web app.
# The GitHub Pages DEV site sets VITE_CSP_API_URL in .github/workflows/deploy-frontend-pages.yml.
# Do not copy that URL into .env or .env.production. A normal production build must not call the DEV backend.
VITE_CSP_API_URL=
